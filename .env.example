# LinkingWordz — environment variables
# Copy to `.env.local` for local development. Never commit secrets.

# Public site URL (canonicals, Open Graph, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress REST API v2 base (public read — architecture Section P)
# Example: https://cms.linkingwordz.com/wp-json/wp/v2
NEXT_PUBLIC_WP_API_URL=

# Optional legacy alias for NEXT_PUBLIC_WP_API_URL
# WORDPRESS_API_URL=

# Optional: hostname for next/image remote patterns
# Defaults to the hostname parsed from NEXT_PUBLIC_WP_API_URL
WORDPRESS_IMAGE_HOSTNAME=

# ---------------------------------------------------------------------------
# Server-only credentials (only if a future feature needs authenticated WP writes)
# NEVER prefix these with NEXT_PUBLIC_
# Contact forms must NOT use WordPress write credentials.
# ---------------------------------------------------------------------------
# WORDPRESS_APPLICATION_PASSWORD=
# FORM_HANDLER_API_KEY=
